{
  "name": "periphery-action",
  "version": "1.1.0",
  "description": "GitHub Action to install a pinned Periphery and scan Swift for unused code.",
  "type": "module",
  "main": "src/main.ts",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "knip": "knip",
    "lint": "eslint",
    "test": "vitest run",
    "type:check": "tsc --noEmit",
    "all": "yarn format && yarn knip && yarn lint && yarn type:check && yarn test && yarn build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apple-Actions/periphery.git"
  },
  "keywords": [
    "actions",
    "apple",
    "swift",
    "periphery",
    "dead-code"
  ],
  "author": "Apple Github Actions (iOS & macOS)",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "~3.0.0",
    "@actions/exec": "~3.0.0",
    "@actions/tool-cache": "~4.0.0",
    "semver": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "~24.19.2",
    "@types/semver": "^7.8.0",
    "esbuild": "~0.28.2",
    "eslint": "~10.13.0",
    "eslint-plugin-github": "~6.1.2",
    "knip": "~6.42.1",
    "prettier": "~3.9.10",
    "typescript": "~7.0.2",
    "vite": "~8.3.3",
    "vitest": "~5.0.5"
  },
  "packageManager": "yarn@4.18.0"
}
